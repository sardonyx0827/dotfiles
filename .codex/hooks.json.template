{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p '__HOME__/.codex/hooks/bash-review-launcher.sh'",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "/bin/bash -p '__HOME__/.codex/hooks/git-push-review.sh'",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p '__HOME__/.codex/hooks/lint.sh'",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p '__HOME__/.codex/hooks/auto-format.sh'",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "/bin/bash -p '__HOME__/.codex/hooks/stop-audit.sh'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
