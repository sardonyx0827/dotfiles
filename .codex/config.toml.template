# model: intentionally unset — inherit the Codex CLI's built-in default,
# which auto-tracks as the CLI updates (no version string to maintain here).
# Pin a tier (e.g. "gpt-5.6-terra") only to deliberately override the default.
model_reasoning_effort = "xhigh"

hide_agent_reasoning = true
personality = "pragmatic"
web_search = "live"

[agents]
max_threads = 6
max_depth = 1

# streamable_shell is gone: Codex CLI 0.167 reports `features.streamable_shell`
# as an unrecognized setting on every run (it ignores the key).
[features]
multi_agent = true
js_repl = false

# Codex reads network access only from this table (it applies to the
# workspace-write sandbox). A top-level `network_access` is not a Codex key
# and is silently ignored.
[sandbox_workspace_write]
network_access = true
