# Codex CLI's own managed system skills (auto-installed at runtime, not ours)
.codex/skills/.system/

# Claude Code's synced skills -- the same story on the Claude side. install.sh
# links ~/.claude/skills at this directory, so the skill sync writes
# third-party skills straight into the working tree (install.sh says as much
# about ~/.codex/skills). None of it is ours to version; untracked, it would
# keep `git status` dirty and feed vendored code to every tool whose scope
# names .claude/skills.
.claude/skills/synced/

# Claude Code's generated mod types -- install.sh links ~/.claude/mods here, and
# each time Claude Code loads a mod it rewrites `.claude-plugin/types/` (the API
# declarations and a tsconfig for the editor) inside the mod's folder. They
# belong to the CLI build that wrote them, not to the mod.
.claude/mods/*/.claude-plugin/types/

# Artifacts generated by this repo's own test suite
# (.pytest_cache/ and .ruff_cache/ self-ignore via their own .gitignore)
__pycache__/
.coverage
.coverage.*

# Safety net for environments where ~/.gitignore_global is not wired yet
# (fresh clone before install.sh, bare containers, worktrees).
# .serena/ writes its own .gitignore but it only covers cache/ and
# project.local.yml, so ignore the whole dir here.
tags
.DS_Store
.serena/
