# Coverage configuration for the Python hook / MCP test suite.
# Measured by pytest-cov in CI (see .github/workflows/ci.yml).
[run]
branch = true
# There is no omit list. .codex/hooks carries neither a copy nor a symlink of
# _bash_review_common.py, and its entry points resolve ../../.claude/hooks from
# their own physical location, so the shared module is a single measured file
# (a duplicate would report 0%: Python's module cache exec's only one copy).
# See tests/test_hook_sync.py, which pins the absence of both the copy and the link.

[report]
show_missing = true
skip_covered = false
exclude_also =
    if __name__ == .__main__.:
    raise NotImplementedError
